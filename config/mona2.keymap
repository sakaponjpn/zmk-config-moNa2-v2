#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100
#define MOUSE 5
#define SCROLL 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <300>;
    flavor = "balanced";
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp RS(TAB)>;
            key-positions = <12 13>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <19 20>;
        };

        ins {
            bindings = <&kp INS>;
            key-positions = <17 18>;
        };

        printscreen {
            bindings = <&kp PRINTSCREEN>;
            key-positions = <18 19>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_up_down: mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        scroll_right_left: mouse_wheel_right_left {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W         &kp E         &kp R        &kp T                                                 &kp Y      &kp U  &lt 6 I    &kp O    &kp P
&kp A             &kp S         &kp D         &kp F        &kp G                                  &lt 2 TAB      &kp H      &kp J  &kp K      &kp L    &mt RIGHT_CONTROL DEL
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V        &kp B        &mo 3                     &mo 1          &kp N      &kp M  &kp COMMA  &kp DOT  &mt TAB RIGHT_SHIFT
&kp LCTRL         &kp LEFT_WIN  &kp LEFT_ALT  &lt 4 LANG2  &lt 5 SPACE  &lt_to_layer_0 2 LANG1    &kp BACKSPACE  &kp ENTER                             &kp ESCAPE
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        num {
            bindings = <
&kp MINUS     &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp PLUS                             &none   &none           &kp UP_ARROW    &none            &trans
&kp SLASH     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp ASTERISK               &kp HOME  &none   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans
&kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PERIOD    &kp EQUAL    &kp END   &none   &none           &none           &none            &trans
&trans        &trans        &trans        &trans        &trans        &trans       &trans    &trans                                                   &trans
            >;

            sensor-bindings = <&scroll_right_left>;
        };

        kigou {
            bindings = <
&kp PERCENT  &kp AT_SIGN  &kp AMPERSAND      &kp CARET        &kp SLASH                       &kp NON_US_BACKSLASH  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp LESS_THAN  &kp GREATER_THAN
&kp GRAVE    &kp TILDE    &kp DOUBLE_QUOTES  &kp SQT          &kp EQUAL               &trans  &kp UNDERSCORE        &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SEMICOLON  &kp COLON
&kp GRAVE    &kp TILDE    &kp MINUS          &kp EXCLAMATION  &kp QUESTION  &trans    &trans  &kp PIPE              &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp SQT        &kp DOUBLE_QUOTES
&trans       &trans       &trans             &trans           &trans        &trans    &trans  &trans                                                                            &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        function {
            bindings = <
&trans      &kp F7  &kp F8  &kp F9  &kp F10                              &kp F1  &kp F2  &kp F3  &kp F4  &kp F5
&trans      &kp F4  &kp F5  &kp F4  &kp F11             &trans           &kp F6  &kp F7  &kp F8  &kp F9  &trans
&kp LSHIFT  &kp F1  &kp F2  &kp F3  &kp F12  &kp INS    &kp PRINTSCREEN  &trans  &trans  &trans  &trans  &kp RIGHT_SHIFT
&trans      &trans  &trans  &trans  &trans   &trans     &trans           &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        bt {
            bindings = <
&trans  &trans  &trans  &trans  &trans                         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans            &trans       &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans    &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans    &trans       &trans                                                  &bt BT_CLR_ALL
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        MOUSE {
            bindings = <
&trans  &trans    &trans    &trans    &trans                    &trans  &trans              &trans    &trans               &trans
&trans  &mkp MB3  &mkp MB2  &mkp MB1  &trans            &trans  &trans  &mkp MB1            &mkp MB3  &mkp MB2             &trans
&trans  &trans    &trans    &trans    &trans  &trans    &trans  &trans  &kp RA(LEFT_ARROW)  &trans    &kp RA(RIGHT_ARROW)  &trans
&trans  &trans    &trans    &trans    &trans  &trans    &trans  &trans                                                     &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };
    };
};
